# CAMPUS GUARDIAN ENVIRONMENT CONFIGURATION

# Application Security
SECRET_KEY=campus-guardian-super-secret-key-hackathon-2026

# Database Configuration (Defaults to local SQLite if left empty)
# SQLite: sqlite:///./campus_guardian.db
# PostgreSQL / Supabase: postgresql://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./campus_guardian.db

# AI Intelligence Engine (Gemini API)
# Optional: If left blank or invalid, Campus Guardian runs in high-fidelity 
# demonstration mode with transparent deterministic heuristics.
GEMINI_API_KEY=

# Optional Supabase Integration (Storage / Realtime / Auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
